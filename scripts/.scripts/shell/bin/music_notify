#!/bin/zsh

playerctl --all-players --ignore-player=chromium,firefox --follow metadata --format '{{playerName}} {{artist}} {{album}} {{title}}' | while read -r line; do
    player=$(echo $line | awk '{print $1}')
    # For sone / tidal music player
    if [[ $player == "io" ]]; then
        player="io.github.lullabyX.sone"
    fi
    if [[ "$(playerctl -p $player status 2>/dev/null)" == "Playing" ]]; then
        music_info $player
    fi
done
